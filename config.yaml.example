# ============================================================
# Goose 配置参考模板 —— 「AI 会计助手」底座
# 实际使用时复制/合并到你本机 goose 配置：
#   Windows:  %APPDATA%\Block\goose\config\config.yaml
#   macOS/Linux:  ~/.config/goose/config.yaml
#
# 最快方式：先跑仓库里的 `bash setup.sh`，它会按你本机自动生成
#   config.local.yaml（含真实路径），你复制到上面位置或手动合并即可。
# 下面这份是「手动写」时的完整参考。
# ============================================================

# ── 1) 用哪个 provider 当主模型 ──────────────────────────────
model_provider: deepseek

providers:
  # 【方案 A】DeepSeek 官方 API（OpenAI 兼容，要用 key）
  deepseek:
    name: deepseek
    engine: openai            # OpenAI 协议
    display_name: DeepSeek
    base_url: https://api.deepseek.com/v1
    api_key_env: DEEPSEEK_API_KEY   # 从环境变量读 key，绝不写进文件
    supports_streaming: true
    models:
      deepseek-chat:
        name: deepseek-chat          # 对话模型（日常）
        max_output_tokens: 4096
      deepseek-reasoner:
        name: deepseek-reasoner      # 推理模型（深思考）
        max_output_tokens: 4096

  # 【方案 B】本地 Ollama（完全免费、离线，想省钱用这个）
  # 先装 Ollama 并 `ollama pull qwen2.5:7b`，再解开下面注释改用它：
  # ollama:
  #   name: ollama
  #   engine: openai
  #   display_name: 本地 Ollama
  #   base_url: http://127.0.0.1:11434/v1
  #   api_key_env: NO_KEY      # 本地无需 key，随便填
  #   supports_streaming: true
  #   models:
  #     qwen2.5:7b: {name: qwen2.5:7b, max_output_tokens: 4096}

# ── 2) 记账扩展：让 AI 读写本地 hledger 账本 ─────────────────
# 开源 @iiatlas/hledger-mcp（MIT），把 hledger 包成工具给 AI 调。
# 前提：hledger 已装、Node 18+ 已装、`npm i -g @iiatlas/hledger-mcp`（建议 ≥ 1.0.5）
extensions:
  hledger-mcp:
    enabled: true
    type: stdio
    name: "hledger 记账"
    description: "读/写本地 hledger 账本（科目、记账、报表）"

    # 方式一（推荐）：node 直接跑该包入口 JS，不联网、最快
    #   下面两行路径替换成你本机真实值（npm prefix -g 可查到，或直接看 setup.sh 生成的 config.local.yaml）
    cmd: node
    args:
      - "E:/npm-global/node_modules/@iiatlas/hledger-mcp/build/index.js"
      - "D:/accounting-agent/ledger/master.journal"
      # 学习期建议先只读，稳定后删掉这行即可解锁「写账」
      - "--read-only"
    timeout: 300

    # 方式二（若不想找入口 JS，用 npx 联网拉，慢一点但省心）：
    # cmd: npx
    # args: ["-y", "@iiatlas/hledger-mcp", "D:/accounting-agent/ledger/master.journal", "--read-only"]
